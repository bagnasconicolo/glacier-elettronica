TEXT 0 0 Left 3 ;Alimentazione: J3 5 V -> U6 3,3 V (+ disaccoppiamenti)
TEXT 2240 0 Left 3 ;Boost LT3461 -> VOUT40 (~41,7 V)
TEXT 0 784 Left 3 ;Regolatore bias SiPM 38,4 V (LT1636, V1)
TEXT 2240 848 Left 3 ;SiPM + amplificatore (Q1 BFR93A, Q2 MMBTH81)
TEXT 2240 1952 Left 3 ;Soglia: U5 3,6 V, V2, R17-R19
TEXT 0 1984 Left 3 ;Comparatore MAX961 + latch C9/R16
TEXT 0 2576 Left 3 ;Uscite: MCP1402 -> J2 TTL 5 V ; 74LVC1G17 -> J4 3,3 V -> Raspberry Pi
TEXT 2240 2800 Left 3 ;Monostabile TLC555 + LED (~11 ms)
TEXT 0 3960 Left 3 ;Riv. Cosmici 2024 (INFN To) - scheda completa. Generato da gen_ltspice.py: non modificare a mano.
TEXT 0 4024 Left 2 ;=====================================================================
TEXT 0 4056 Left 2 ;riv_cosmici_completo.cir - SCHEDA COMPLETA "Riv. Cosmici 2024"
TEXT 0 4088 Left 2 ;(INFN sez. Torino, S. Gallian - "Amplif, alim, soglie", rev. A)
TEXT 0 4120 Left 2 ;+ buffer d'uscita 3,3 V verso Raspberry Pi.
TEXT 0 4152 Left 2 ;
TEXT 0 4184 Left 2 ;GENERATO da gen_ltspice.py a partire da hardware/generator/netdata.py,
TEXT 0 4216 Left 2 ;lo stesso modello dati dello schema KiCad: riferimenti e nomi di rete
TEXT 0 4248 Left 2 ;sono quelli dello schema (GND = 0, +5V = V5, +3V3 = V3V3, +3V6 = V3V6).
TEXT 0 4280 Left 2 ;Non modificare a mano: cambia netdata.py e rigenera.
TEXT 0 4312 Left 2 ;
TEXT 0 4344 Left 2 ;LTspice : apri riv_cosmici_completo.asc (schema) oppure questo file
TEXT 0 4376 Left 2 ;(File > Open, tipo file: Netlists) e premi Run. Modelli e
TEXT 0 4408 Left 2 ;simboli .asy devono stare nella stessa cartella.
TEXT 0 4440 Left 2 ;ngspice : ngspice -b riv_cosmici_completo.cir
TEXT 0 4472 Left 2 ;
TEXT 0 4504 Left 2 ;Cosa succede nel transitorio (30 ms):
TEXT 0 4536 Left 2 ;0-0,1 ms  la +5V sale (J3), partono i regolatori 3,3 V e 3,6 V
TEXT 0 4568 Left 2 ;0-3 ms    il boost LT3461 carica VOUT40 (~41,7 V), l'LT1636 porta
TEXT 0 4600 Left 2 ;il bias del SiPM (rete BIAS) a ~38,4 V
TEXT 0 4632 Left 2 ;10 ms     EV1..EV4: un muone grande, un dark count (1 p.e., sotto soglia),
TEXT 0 4664 Left 2 ;un muone medio, un muone ravvicinato al terzo
TEXT 0 4696 Left 2 ;Uscite:   CMP_Q/CMP_QB (3,3 V), TTL_OUT (5 V, J2), BUF_OUT (J4 ->
TEXT 0 4728 Left 2 ;GPIO Raspberry Pi, 0-3,3 V), LED D3 acceso ~11 ms dal 555
TEXT 0 4760 Left 2 ;=====================================================================
TEXT 0 4792 Left 2 !.include riv_cosmici_modelli.lib
TEXT 0 4824 Left 2 ;----------------------------- parametri -----------------------------
TEXT 0 4856 Left 2 !.param VIN=5
TEXT 0 4888 Left 2 ;V1 (regolazione tensione SiPM): frazione di pista dal pin 1 (lato R7).
TEXT 0 4920 Left 2 ;POS piu' alto = cursore verso D1 = bias piu' alto. 0,76 -> ~38,4 V
TEXT 0 4952 Left 2 !.param V1_POS=0.76
TEXT 0 4984 Left 2 ;V2 (soglia): frazione di pista dal pin 1 (lato R19, alto) al cursore.
TEXT 0 5016 Left 2 ;soglia ~ 1,286 V * (1 - V2_POS).  0,92 -> ~100 mV (~3 p.e.)
TEXT 0 5048 Left 2 !.param V2_POS=0.92
TEXT 0 5080 Left 2 ;capacita' terminale del SiPM (dal datasheet del sensore usato): divide la
TEXT 0 5112 Left 2 ;carica con l'ingresso dell'amplificatore e cambia i mV per fotoelettrone
TEXT 0 5144 Left 2 !.param CSIPM=100p
TEXT 0 5176 Left 2 ;eventi nel SiPM: istante [s] e numero di fotoelettroni (0,5 pC/p.e.)
TEXT 0 5208 Left 2 !.param T_EV1=10m     NPE_EV1=250
TEXT 0 5240 Left 2 !.param T_EV2=10.01m  NPE_EV2=1
TEXT 0 5272 Left 2 !.param T_EV3=10.02m  NPE_EV3=40
TEXT 0 5304 Left 2 !.param T_EV4=10.0215m NPE_EV4=150
TEXT 0 5336 Left 2 ;----------------------------- analisi -------------------------------
TEXT 0 5368 Left 2 !.tran 1u 30m 0 2u
TEXT 0 5400 Left 2 ;---- misure (identiche in LTspice e ngspice; in LTspice i risultati
TEXT 0 5432 Left 2 ;sono in View > SPICE Error Log)
TEXT 0 5464 Left 2 ;punto di lavoro a riposo (prima degli eventi)
TEXT 0 5496 Left 2 !.meas tran V_3V3     FIND V(V3V3)   AT=9.9m
TEXT 0 5528 Left 2 !.meas tran V_3V6     FIND V(V3V6)   AT=9.9m
TEXT 0 5560 Left 2 !.meas tran V_REFB    FIND V(VREF_B) AT=9.9m
TEXT 0 5592 Left 2 !.meas tran V_OUT40   FIND V(VOUT40) AT=9.9m
TEXT 0 5624 Left 2 !.meas tran V_FB      FIND V(FB)     AT=9.9m
TEXT 0 5656 Left 2 !.meas tran V_SET     FIND V(VSET)   AT=9.9m
TEXT 0 5688 Left 2 !.meas tran V_BIAS    FIND V(BIAS)   AT=9.9m
TEXT 0 5720 Left 2 !.meas tran V_TH      FIND V(TH)     AT=9.9m
TEXT 0 5752 Left 2 !.meas tran VB_Q1     FIND V(Q1B)    AT=9.9m
TEXT 0 5784 Left 2 !.meas tran VC_Q1     FIND V(Q1C)    AT=9.9m
TEXT 0 5816 Left 2 !.meas tran VE_Q2     FIND V(Q2E)    AT=9.9m
TEXT 0 5848 Left 2 !.meas tran VC_Q2     FIND V(Q2C)    AT=9.9m
TEXT 0 5880 Left 2 !.meas tran I_5V      FIND I(VJ3)    AT=9.9m
TEXT 0 5912 Left 2 !.meas tran T_BIAS_OK WHEN V(BIAS)=38 RISE=1
TEXT 0 5944 Left 2 ;evento 1: muone 250 p.e.
TEXT 0 5976 Left 2 !.meas tran PK_EV1    MAX  V(CMP_IN)  FROM=9.999m  TO=10.003m
TEXT 0 6008 Left 2 !.meas tran Q_EV1     MAX  V(CMP_Q)   FROM=9.999m  TO=10.003m
TEXT 0 6040 Left 2 !.meas tran TTL_EV1   MAX  V(TTL_OUT) FROM=9.999m  TO=10.003m
TEXT 0 6072 Left 2 !.meas tran RPI_EV1   MAX  V(RPI_GPIO)  FROM=9.999m  TO=10.003m
TEXT 0 6104 Left 2 !.meas tran W_Q_EV1   TRIG V(CMP_Q)   VAL=1.65 RISE=1 TD=9.99m TARG V(CMP_Q)   VAL=1.65 FALL=1 TD=9.99m
TEXT 0 6136 Left 2 !.meas tran W_TTL_EV1 TRIG V(TTL_OUT) VAL=2.5  RISE=1 TD=9.99m TARG V(TTL_OUT) VAL=2.5  FALL=1 TD=9.99m
TEXT 0 6168 Left 2 !.meas tran W_RPI_EV1 TRIG V(RPI_GPIO)  VAL=1.65 RISE=1 TD=9.99m TARG V(RPI_GPIO)  VAL=1.65  FALL=1 TD=9.99m
TEXT 0 6200 Left 2 !.meas tran D_RPI_EV1 TRIG V(CMP_Q)   VAL=1.65 RISE=1 TD=9.99m TARG V(RPI_GPIO)  VAL=1.65  RISE=1 TD=9.99m
